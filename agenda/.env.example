# Copie para .env (local) ou cadastre no Coolify. Nunca suba o .env para o GitHub.
FEEGOW_MCP_URL=
FEEGOW_MCP_TOKEN=
# 1 = grava no Feegow de verdade. Vazio/0 = modo teste (confere tudo e responde "simulado")
PERMITIR_AGENDAR=
# sites que podem chamar a API pelo navegador, separados por vírgula
CORS_ORIGINS=https://clinicadias.com
# unidades do site (0 Timóteo Portaria I, 1 Fabriciano, 7 Portaria 2, 8 Ipatinga)
UNIDADES=0,1,7,8
# vazio = todas as especialidades com agendamento on-line no Feegow, menos as de fora
ESPECIALIDADES=
ESPECIALIDADES_FORA=94,306,296,297,300,144,106
# consulta padrão errada no Feegow (3229 = CONSULTA UROLOGISTA em várias especialidades)
CONSULTAS_FORA=3229
# vazio = todos os profissionais com horário livre
PROFISSIONAIS=
DIAS=30
CATALOGO_MINUTOS=30
TELEFONE=(31) 3849-6156
NOTA_AGENDAMENTO=Marcado pelo site da Clínica Dias
