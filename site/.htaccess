# Apache (aaPanel) da clinicadias.com
# Junta as regras de segurança que já estavam na VPS com o que o site novo precisa.

Options -Indexes
ErrorDocument 404 /404.html

# Tipos que o Apache não conhece sozinho: sem eles o mapa (.mjs) e o passeio 3D (.wasm, .glb) não abrem
<IfModule mod_mime.c>
  AddType application/javascript .mjs
  AddType application/wasm .wasm
  AddType model/gltf-binary .glb
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Sempre https e sem www (o desafio do certificado continua abrindo por http)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://clinicadias.com%{REQUEST_URI} [L,R=301]

  # Endereços do site antigo
  RewriteRule ^quem-somos\.html$ /a-clinica.html [L,R=301]
  RewriteRule ^contato\.html$ /atendimento.html [L,R=301]
  RewriteRule ^localizacao\.html$ /atendimento.html [L,R=301]

  # Bloqueia arquivos ocultos e de backup/código (menos o desafio do certificado).
  # .json e .mjs NÃO entram aqui: o passeio (luz.json) e o mapa (maplibre-gl.mjs) precisam deles.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]
  RewriteRule \.(env|bak|sql|log|sh|md|ps1|py|blend|zip|tar|gz)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # O que o site carrega de fora: three.js e gsap do passeio (jsdelivr), mapa (OpenFreeMap),
  # avaliações (Google Places) e fotos de quem avaliou (googleusercontent).
  # 'unsafe-inline': as páginas têm scripts e estilos no próprio HTML. blob: e wasm: mapa e Draco do passeio.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self' data:; connect-src 'self' data: blob: https://tiles.openfreemap.org https://places.googleapis.com https://cdn.jsdelivr.net; worker-src 'self' blob:; media-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; upgrade-insecure-requests"

  <FilesMatch "\.(webp|png|jpe?g|svg|woff2|mp3|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(glb|wasm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|json)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/wasm model/gltf-binary image/svg+xml application/xml text/plain
</IfModule>
